<UserControl x:Class="EtherDNS.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:EtherDNS.Core">
    <UserControl.Resources>
        <Style x:Key="UpdateProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="3" Background="#1AFFFFFF"/>
                            <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                    Background="{StaticResource AccentGradient}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer Style="{StaticResource FadeScroller}">
        <StackPanel Margin="0,20,16,30">
            <TextBlock Text="About" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="The people and the story behind EtherDNS." Style="{StaticResource PageSubtitle}"/>

            <!-- Hero -->
            <Border CornerRadius="14" Padding="36" Margin="0,24,0,0" Background="{StaticResource HeroGradient}"
                    BorderBrush="{StaticResource CardStroke}" BorderThickness="1" core:Reveal.Delay="0:0:0.04">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <core:IconBadge Glyph="&#xE774;" Tint="brand" Size="96"/>
                    <StackPanel Grid.Column="1" Margin="30,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="EtherDNS" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentGradientH}"/>
                        <TextBlock FontSize="14" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0">
                            <Run Text="Version"/>
                            <Run Text="{Binding Version, Mode=OneWay}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                            <Run Text="  ·  DNS changer &amp; network toolkit for Windows"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" Margin="0,14,0,0" MaxWidth="620" HorizontalAlignment="Left" LineHeight="21">
                            <Run Text="Switch between"/>
                            <Run Text="{Binding DnsItems.Count, Mode=OneWay}"/>
                            <Run Text="curated DNS providers, benchmark them from your own connection, reset your network and recover saved Wi-Fi passwords — all from one place."/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Software update -->
            <TextBlock Text="Software Update" Style="{StaticResource SectionTitle}" Margin="0,30,0,14"/>
            <Border Style="{StaticResource Card}" Padding="22,20" core:Reveal.Delay="0:0:0.08">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <core:IconBadge VerticalAlignment="Center" Glyph="&#xE895;" Size="44">
                            <core:IconBadge.Style>
                                <Style TargetType="core:IconBadge" BasedOn="{StaticResource {x:Type core:IconBadge}}">
                                    <Setter Property="Tint" Value="green"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                            <Setter Property="Tint" Value="brand"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </core:IconBadge.Style>
                        </core:IconBadge>
                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                            <TextBlock FontSize="15" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="EtherDNS is up to date"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                <Setter Property="Text" Value="{Binding UpdateHeadline}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding UpdateMessage}" FontSize="12.5" Foreground="{StaticResource SubTextBrush}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Click="ReleaseNotes_Click" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Releases"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="CheckUpdate_Click"
                                    IsEnabled="{Binding CanCheckUpdate}"
                                    Visibility="{Binding CanCheckUpdate, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Check for Updates"/>
                                </StackPanel>
                            </Button>
                            <Control Template="{StaticResource SpinnerTemplate}" Width="20" Height="20" Margin="6,0"
                                     Visibility="{Binding IsCheckingUpdate, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource PrimaryButton}" Click="InstallUpdate_Click"
                                    Visibility="{Binding CanInstallUpdate, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding UpdateButtonText}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Content="Cancel" Click="CancelUpdate_Click"
                                    Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Download progress -->
                    <ProgressBar Style="{StaticResource UpdateProgress}" Value="{Binding UpdateProgress, Mode=OneWay}" Margin="0,16,0,0"
                                 Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}"/>

                    <!-- What's new in the available version -->
                    <Border Margin="0,16,0,0" CornerRadius="10" Background="#0DFFFFFF" Padding="16,12"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="WHAT'S NEW" Style="{StaticResource Caption}"/>
                            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                <TextBlock Text="{Binding AvailableUpdate.Notes}" TextWrapping="Wrap" FontSize="12.5"
                                           Foreground="{StaticResource SubTextBrush}" LineHeight="19"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="Developer" Style="{StaticResource SectionTitle}" Margin="0,30,0,14"/>
            <Grid core:Reveal.Stagger="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource TileButton}" Tag="https://t.me/DevRouter" Click="Link_Click">
                    <StackPanel>
                        <core:IconBadge HorizontalAlignment="Left" Margin="0,0,0,16" Glyph="&#xE724;" Tint="teal" Size="38"/>
                        <TextBlock Text="Telegram" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="t.me/DevRouter" Foreground="{StaticResource SubTextBrush}" FontWeight="Normal" FontSize="12.5" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource TileButton}" Tag="https://github.com/DevURANIUM" Click="Link_Click">
                    <StackPanel>
                        <core:IconBadge HorizontalAlignment="Left" Margin="0,0,0,16" Glyph="&#xE943;" Tint="purple" Size="38"/>
                        <TextBlock Text="GitHub" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="github.com/DevURANIUM" Foreground="{StaticResource SubTextBrush}" FontWeight="Normal" FontSize="12.5" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource TileButton}" Tag="mailto:info@heydari.org" Click="Link_Click">
                    <StackPanel>
                        <core:IconBadge HorizontalAlignment="Left" Margin="0,0,0,16" Glyph="&#xE715;" Tint="pink" Size="38"/>
                        <TextBlock Text="Email" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="info@heydari.org" Foreground="{StaticResource SubTextBrush}" FontWeight="Normal" FontSize="12.5" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xEB51;" Style="{StaticResource Icon}" FontSize="20" Foreground="#FFFF375F"/>
                    <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}"
                               Text="If you like this project, a star on GitHub or a donation keeps it going. Thank you!"/>
                </Grid>
            </Border>

            <TextBlock Text="Copyright © DevUranium. All rights reserved." Foreground="{StaticResource MutedBrush}" FontSize="12"
                       Margin="0,26,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
