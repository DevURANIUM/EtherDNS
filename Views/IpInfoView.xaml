<UserControl x:Class="EtherDNS.Views.IpInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:EtherDNS.Core">
    <UserControl.Resources>
        <Style x:Key="DetailCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>
        <Style x:Key="DetailIcon" TargetType="core:IconBadge" BasedOn="{StaticResource {x:Type core:IconBadge}}">
            <Setter Property="Size" Value="34"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,16,22">
            <StackPanel>
                <TextBlock Text="IP Info" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Your public IP as the internet sees it, plus your local network details." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center"
                            Visibility="{Binding IsLoadingIp, Converter={StaticResource BoolToVis}}">
                    <Control Template="{StaticResource SpinnerTemplate}" Width="16" Height="16"/>
                    <TextBlock Text="Looking up…" Foreground="{StaticResource SubTextBrush}" FontSize="12.5" Margin="8,0,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource PrimaryButton}" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,9,0"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" Style="{StaticResource FadeScroller}"
                      Visibility="{Binding HasPublicIp, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="0,10,0,30">
                <!-- Hero -->
                <Border CornerRadius="14" Padding="32,28" Margin="0,0,14,0" Background="{StaticResource HeroGradient}"
                        BorderBrush="{StaticResource CardStroke}" BorderThickness="1" core:Reveal.Delay="0:0:0.04">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- App-icon style globe with country badge -->
                        <Grid Width="96" Height="96" VerticalAlignment="Center">
                            <core:IconBadge Glyph="&#xE909;" Tint="brand" Size="96"/>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-8,-6" CornerRadius="7"
                                    Padding="7,2" Background="#FF2C2C2E" BorderBrush="#33FFFFFF" BorderThickness="1">
                                <TextBlock Text="{Binding PublicIp.CountryCodeText}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="26,0,20,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="YOUR PUBLIC IP" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <Border CornerRadius="7" Padding="7,2" Margin="10,0,0,0" Background="#1A5B8CFF" BorderBrush="#405B8CFF" BorderThickness="1">
                                    <TextBlock Text="{Binding PublicIp.IpVersion}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent1Brush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding PublicIp.Ip}" FontFamily="{StaticResource MonoFont}" FontSize="32" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentGradientH}" Margin="0,6,0,6" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE707;" Style="{StaticResource Icon}" FontSize="14" Foreground="#FFFF375F" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding PublicIp.Location}" FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Accent1Brush}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding PublicIp.IspText}" FontSize="13.5" Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="170">
                            <Button Style="{StaticResource PrimaryButton}" Click="CopyIp_Click" Padding="18,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,9,0"/>
                                    <TextBlock Text="Copy IP"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="Map_Click" Margin="0,10,0,0" Padding="18,11"
                                    IsEnabled="{Binding PublicIp.HasCoordinates}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE826;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,9,0"/>
                                    <TextBlock Text="Show on Map"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="CopyAll_Click" Margin="0,10,0,0" Padding="18,11">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,9,0"/>
                                    <TextBlock Text="Copy Details"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Connection details -->
                <TextBlock Text="Connection Details" Style="{StaticResource SectionTitle}" Margin="0,28,0,14"/>
                <UniformGrid Columns="4" core:Reveal.Stagger="True">
                    <Border Style="{StaticResource DetailCard}">
                        <StackPanel Orientation="Horizontal">
                            <core:IconBadge Style="{StaticResource DetailIcon}" Glyph="&#xE909;" Tint="blue"/>
                            <StackPanel MaxWidth="150">
                                <TextBlock Text="COUNTRY" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding PublicIp.CountryText}" Style="{StaticResource DetailValue}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DetailCard}">
                        <StackPanel Orientation="Horizontal">
                            <core:IconBadge Style="{StaticResource DetailIcon}" Glyph="&#xE80F;" Tint="purple"/>
                            <StackPanel MaxWidth="150">
                                <TextBlock Text="REGION" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding PublicIp.RegionText}" Style="{StaticResource DetailValue}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DetailCard}">
                        <StackPanel Orientation="Horizontal">
                            <core:IconBadge Style="{StaticResource DetailIcon}" Glyph="&#xE707;" Tint="pink"/>
                            <StackPanel MaxWidth="150">
                                <TextBlock Text="CITY" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding PublicIp.CityText}" Style="{StaticResource DetailValue}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DetailCard}">
                        <StackPanel Orientation="Horizontal">
                            <core:IconBadge Style="{StaticResource DetailIcon}" Glyph="&#xE823;" Tint="green"/>
                            <StackPanel MaxWidth="150">
                                <TextBlock Text="TIMEZONE" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding PublicIp.TimezoneText}" Style="{StaticResource DetailValue}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DetailCard}">
                        <StackPanel Orientation="Horizontal">
                            <core:IconBadge Style="{StaticResource DetailIcon}" Glyph="&#xE968;" Tint="orange"/>
                            <StackPanel MaxWidth="150">
                                <TextBlock Text="ISP" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding PublicIp.IspText}" Style="{StaticResource DetailValue}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DetailCard}">
                        <StackPanel Orientation="Horizontal">
                            <core:IconBadge Style="{StaticResource DetailIcon}" Glyph="&#xE821;" Tint="teal"/>
                            <StackPanel MaxWidth="150">
                                <TextBlock Text="ORGANIZATION" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding PublicIp.OrgText}" Style="{StaticResource DetailValue}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DetailCard}">
                        <StackPanel Orientation="Horizontal">
                            <core:IconBadge Style="{StaticResource DetailIcon}" Glyph="&#xE943;" Tint="purple"/>
                            <StackPanel MaxWidth="150">
                                <TextBlock Text="ASN" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding PublicIp.AsnText}" Style="{StaticResource DetailValue}" FontFamily="{StaticResource MonoFont}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DetailCard}">
                        <StackPanel Orientation="Horizontal">
                            <core:IconBadge Style="{StaticResource DetailIcon}" Glyph="&#xE81D;" Tint="blue"/>
                            <StackPanel MaxWidth="150">
                                <TextBlock Text="COORDINATES" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding PublicIp.CoordinatesText}" Style="{StaticResource DetailValue}" FontFamily="{StaticResource MonoFont}" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Local network -->
                <TextBlock Text="Local Network" Style="{StaticResource SectionTitle}" Margin="0,16,0,14"/>
                <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="24,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="ADAPTER" Style="{StaticResource Caption}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding SelectedAdapter.Icon, FallbackValue=''}" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Accent1Brush}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SelectedAdapter.Name, FallbackValue=—}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="LOCAL IP" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding SelectedAdapter.IPv4, FallbackValue=—}" Style="{StaticResource Mono}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="GATEWAY" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding SelectedAdapter.Gateway, FallbackValue=—}" Style="{StaticResource Mono}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="MAC ADDRESS" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding SelectedAdapter.Mac, FallbackValue=—}" Style="{StaticResource Mono}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Text="DNS SERVERS" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding ActiveDnsText}" ToolTip="{Binding ActiveDnsFull}" Style="{StaticResource Mono}" FontSize="13" FontWeight="SemiBold" Margin="0,4,16,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="DNS MODE" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding DnsModeText}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,16,0,0" HorizontalAlignment="Center">
                    <Run Text="Lookup data provided by"/>
                    <Run Text="{Binding PublicIp.Source, Mode=OneWay}" Foreground="{StaticResource SubTextBrush}"/>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <!-- First load -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="FirstLoad">
            <Control Template="{StaticResource SpinnerTemplate}" Width="48" Height="48"/>
            <TextBlock Text="Finding your public IP…" Foreground="{StaticResource SubTextBrush}" Margin="0,16,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Error -->
        <Border Grid.Row="1" Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36,30"
                x:Name="ErrorCard" Visibility="Collapsed">
            <StackPanel>
                <Border Width="64" Height="64" CornerRadius="20" Background="#22FF453A" HorizontalAlignment="Center">
                    <TextBlock Text="&#xEB55;" Style="{StaticResource Icon}" FontSize="28" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="Couldn't look up your IP" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                <TextBlock Text="{Binding IpError}" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" Margin="0,6,0,18"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Try Again" HorizontalAlignment="Center" Click="Refresh_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
