<UserControl x:Class="EtherDNS.Views.DnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:EtherDNS.Core">
    <UserControl.Resources>
        <!-- Latency badge colors -->
        <Style x:Key="LatencyBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LatencyLevel}" Value="good"><Setter Property="Background" Value="#2230D158"/></DataTrigger>
                <DataTrigger Binding="{Binding LatencyLevel}" Value="ok"><Setter Property="Background" Value="#22FF9F0A"/></DataTrigger>
                <DataTrigger Binding="{Binding LatencyLevel}" Value="bad"><Setter Property="Background" Value="#22FF9F0A"/></DataTrigger>
                <DataTrigger Binding="{Binding LatencyLevel}" Value="fail"><Setter Property="Background" Value="#22FF453A"/></DataTrigger>
                <DataTrigger Binding="{Binding LatencyLevel}" Value="testing"><Setter Property="Background" Value="#225B8CFF"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LatencyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Text" Value="{Binding LatencyText}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LatencyLevel}" Value="good"><Setter Property="Foreground" Value="#FF30D158"/></DataTrigger>
                <DataTrigger Binding="{Binding LatencyLevel}" Value="ok"><Setter Property="Foreground" Value="#FFFF9F0A"/></DataTrigger>
                <DataTrigger Binding="{Binding LatencyLevel}" Value="bad"><Setter Property="Foreground" Value="#FFFF9F0A"/></DataTrigger>
                <DataTrigger Binding="{Binding LatencyLevel}" Value="fail"><Setter Property="Foreground" Value="#FFFF453A"/></DataTrigger>
                <DataTrigger Binding="{Binding LatencyLevel}" Value="testing"><Setter Property="Foreground" Value="#FF5B8CFF"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="DnsCard" DataType="{x:Type core:DnsItem}">
            <Grid Width="276" Margin="0,0,16,16">
                <!-- Glow behind the active card -->
                <Border x:Name="Glow" CornerRadius="20" Background="{StaticResource AccentGradient}" Opacity="0" Margin="2">
                    <Border.Effect><BlurEffect Radius="22"/></Border.Effect>
                </Border>
                <Border x:Name="Card" CornerRadius="12" Padding="18" Background="{StaticResource CardSolidBrush}" BorderBrush="{StaticResource CardStroke}" BorderThickness="1">

                    <Border.RenderTransform>
                        <TranslateTransform/>
                    </Border.RenderTransform>
                    <StackPanel>
                        <!-- Header -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <core:IconBadge Letter="{Binding Initial}" Brush="{Binding Accent}" Size="38"/>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Category}" FontSize="11.5" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border x:Name="ActiveBadge" Grid.Column="2" CornerRadius="8" Padding="8,3" Background="#2230D158"
                                    VerticalAlignment="Top" Visibility="Collapsed">
                                <TextBlock Text="ACTIVE" FontSize="10" FontWeight="Bold" Foreground="#FF30D158"/>
                            </Border>
                            <Border x:Name="FastBadge" Grid.Column="2" CornerRadius="8" Padding="8,3" Background="#22FF9F0A"
                                    VerticalAlignment="Top" Visibility="Collapsed">
                                <TextBlock Text="★ FASTEST" FontSize="10" FontWeight="Bold" Foreground="#FFFF9F0A"/>
                            </Border>
                        </Grid>

                        <!-- Addresses (click to copy) -->
                        <Border Margin="0,16,0,0" CornerRadius="12" Background="#0AFFFFFF" Padding="12,10">
                            <StackPanel>
                                <Grid Cursor="Hand" Background="Transparent" Tag="{Binding Primary}" MouseLeftButtonUp="CopyIp_Click" ToolTip="Click to copy">
                                    <TextBlock Text="Primary" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding Primary}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Rectangle Height="1" Fill="#0FFFFFFF" Margin="0,8"/>
                                <Grid Cursor="Hand" Background="Transparent" Tag="{Binding Secondary}" MouseLeftButtonUp="CopyIp_Click" ToolTip="Click to copy">
                                    <TextBlock Text="Secondary" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding Secondary}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Footer -->
                        <Grid Margin="0,16,0,0">
                            <Border Style="{StaticResource LatencyBadge}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEC4A;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"
                                               Foreground="{Binding Foreground, ElementName=Lat}"/>
                                    <TextBlock x:Name="Lat" Style="{StaticResource LatencyText}"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource MiniIconButton}" Content="&#xE9D9;" ToolTip="Test speed"
                                        Click="TestOne_Click" Margin="0,0,8,0"/>
                                <Button x:Name="ApplyBtn" Click="Apply_Click" Padding="16,8" FontSize="12.5">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Content" Value="Apply"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Content" Value="✓ Active"/>
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFastest}" Value="True">
                    <Setter TargetName="FastBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="ActiveBadge" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="FastBadge" Property="Visibility" Value="Collapsed"/>
                    
                    <Setter TargetName="Card" Property="BorderBrush" Value="#FF5B8CFF"/>
                </DataTrigger>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-4" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="DNS Servers" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageSubtitle}">
                    <Run Text="Pick a server or bring your own. Applying to"/>
                    <Run Text="{Binding SelectedAdapter.Name, Mode=OneWay, FallbackValue=—}" Foreground="{StaticResource Accent1Brush}" FontWeight="SemiBold"/>
                </TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Click="Reset_Click" Margin="0,0,10,0"
                        ToolTip="Remove custom DNS from the selected adapter">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE894;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,9,0"/>
                        <TextBlock Text="Remove DNS"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Click="RemoveAll_Click" Margin="0,0,10,0"
                        ToolTip="Remove custom DNS from every network adapter">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B3;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,9,0"/>
                        <TextBlock Text="All Adapters"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Click="TestAll_Click" x:Name="TestAllButton">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEC4A;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,9,0"/>
                        <TextBlock x:Name="TestAllText" Text="Test All Speeds"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Custom DNS -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,18" Margin="0,0,16,20" core:Reveal.Delay="0:0:0.03">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <core:IconBadge Glyph="&#xE70F;" Tint="pink" Size="40"/>
                <StackPanel Grid.Column="1" Margin="14,0,24,0" VerticalAlignment="Center">
                    <TextBlock Text="Custom DNS" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="Set any servers manually" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBox Grid.Column="2" x:Name="CustomPrimary" Style="{StaticResource Input}" Tag="Primary  e.g. 9.9.9.9"
                         FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="4" x:Name="CustomSecondary" Style="{StaticResource Input}" Tag="Secondary (optional)"
                         FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                <Border Grid.Column="5" x:Name="CustomLatencyBadge" CornerRadius="9" Padding="10,6" Margin="12,0,0,0"
                        Background="#10FFFFFF" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="CustomLatency" FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE9D9;" Width="42" Height="42" ToolTip="Test speed"
                            Click="TestCustom_Click" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Apply" Click="ApplyCustom_Click" Padding="22,11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Category filters -->
        <WrapPanel Grid.Row="2" Margin="0,0,16,12">
            <RadioButton Style="{StaticResource Chip}" Content="All" GroupName="Cat" IsChecked="True" Tag="All" Checked="Category_Checked"/>
            <RadioButton Style="{StaticResource Chip}" Content="Gaming" GroupName="Cat" Tag="Game" Checked="Category_Checked"/>
            <RadioButton Style="{StaticResource Chip}" Content="Iranian" GroupName="Cat" Tag="Iran" Checked="Category_Checked"/>
            <RadioButton Style="{StaticResource Chip}" Content="Global" GroupName="Cat" Tag="Global" Checked="Category_Checked"/>
            <RadioButton Style="{StaticResource Chip}" Content="Privacy" GroupName="Cat" Tag="Privacy" Checked="Category_Checked"/>
            <RadioButton Style="{StaticResource Chip}" Content="Ad Block" GroupName="Cat" Tag="AdBlock" Checked="Category_Checked"/>
            <RadioButton Style="{StaticResource Chip}" Content="Security" GroupName="Cat" Tag="Security" Checked="Category_Checked"/>
            <RadioButton Style="{StaticResource Chip}" Content="Family" GroupName="Cat" Tag="Family" Checked="Category_Checked"/>
        </WrapPanel>

        <!-- Search + sort -->
        <Grid Grid.Row="3" Margin="0,0,16,8">
            <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding SortBySpeed}" HorizontalAlignment="Left"
                          ToolTip="Rank every server by measured speed (run Test All Speeds first)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8CB;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0"/>
                    <TextBlock Text="Sort by speed"/>
                </StackPanel>
            </ToggleButton>
            <TextBox Style="{StaticResource SearchInput}" Tag="Search name or IP…" Width="270" HorizontalAlignment="Right"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <!-- Cards, grouped by section -->
        <ScrollViewer Grid.Row="4" Style="{StaticResource FadeScroller}">
            <ItemsControl ItemsSource="{Binding DnsView}" ItemTemplate="{StaticResource DnsCard}" Margin="0,6,0,30" core:Reveal.Stagger="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,10,0,12">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                    <Border CornerRadius="8" Padding="7,1" Margin="10,0,0,0" Background="#14FFFFFF" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ItemCount}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubTextBrush}"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
