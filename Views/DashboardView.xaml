<UserControl x:Class="EtherDNS.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:EtherDNS.Core">
    <UserControl.Resources>
        <DataTemplate x:Key="AdapterTemplate" DataType="{x:Type core:AdapterInfo}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" Foreground="{StaticResource Accent1Brush}" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"/>
                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource SubTextBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="InfoChip" TargetType="Border">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="BorderBrush" Value="#12FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>

        <Style x:Key="TileIcon" TargetType="core:IconBadge" BasedOn="{StaticResource {x:Type core:IconBadge}}">
            <Setter Property="Size" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource FadeScroller}" Padding="0,0,6,0">
        <StackPanel Margin="0,20,0,30">
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Network Overview" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="See what your connection is using and switch DNS in one click." Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox Style="{StaticResource DarkCombo}" Width="290" ItemsSource="{Binding Adapters}"
                              SelectedItem="{Binding SelectedAdapter}" ItemTemplate="{StaticResource AdapterTemplate}"
                              ToolTip="Network adapter"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Width="46" Height="46" Margin="10,0,0,0"
                            ToolTip="Refresh" Click="Refresh_Click"/>
                </StackPanel>
            </Grid>

            <!-- Hero -->
            <Border CornerRadius="14" Padding="34,30" Background="{StaticResource HeroGradient}"
                    BorderBrush="{StaticResource CardStroke}" BorderThickness="1" core:Reveal.Delay="0:0:0.04">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App-icon style status tile -->
                    <core:IconBadge VerticalAlignment="Center" Glyph="&#xEA18;" Tint="brand" Size="92"/>

                    <!-- Status text -->
                    <StackPanel Grid.Column="1" Margin="26,0,20,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                        <Border CornerRadius="10" Padding="11,5" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#1A5B8CFF"/>
                                    <Setter Property="BorderBrush" Value="#405B8CFF"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomDns}" Value="True">
                                            <Setter Property="Background" Value="#1A30D158"/>
                                            <Setter Property="BorderBrush" Value="#4030D158"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="11" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="AUTOMATIC DNS · DHCP"/>
                                        <Setter Property="Foreground" Value="{StaticResource Accent1Brush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCustomDns}" Value="True">
                                                <Setter Property="Text" Value="● CUSTOM DNS ACTIVE"/>
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <Border CornerRadius="10" Padding="10,5" Margin="8,0,0,0" Background="#0FFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                                ToolTip="Live response time of your current DNS">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEC4A;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding LiveLatencyText}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding ActiveProviderName}" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentGradientH}" Margin="0,10,0,2" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ActiveDnsText}" ToolTip="{Binding ActiveDnsFull}" Style="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>

                        <WrapPanel Margin="0,20,0,-10">
                            <Border Style="{StaticResource InfoChip}">
                                <StackPanel>
                                    <TextBlock Text="ADAPTER" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding SelectedAdapter.Name, FallbackValue=—}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InfoChip}">
                                <StackPanel>
                                    <TextBlock Text="LOCAL IP" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding SelectedAdapter.IPv4, FallbackValue=—}" Style="{StaticResource Mono}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InfoChip}">
                                <StackPanel>
                                    <TextBlock Text="GATEWAY" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding SelectedAdapter.Gateway, FallbackValue=—}" Style="{StaticResource Mono}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InfoChip}">
                                <StackPanel>
                                    <TextBlock Text="LINK SPEED" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding SelectedAdapter.SpeedText, FallbackValue=—}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InfoChip}">
                                <StackPanel>
                                    <TextBlock Text="DNS MODE" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding DnsModeText}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Hero actions -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="190">
                        <Button Style="{StaticResource PrimaryButton}" Click="Browse_Click" Padding="18,13">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,10,0"/>
                                <TextBlock Text="Change DNS"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Click="Reset_Click" Margin="0,10,0,0" Padding="18,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE894;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"/>
                                <TextBlock Text="Remove DNS"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Quick actions -->
            <TextBlock Text="Quick Actions" Style="{StaticResource SectionTitle}" Margin="0,30,0,14"/>
            <Grid core:Reveal.Stagger="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource TileButton}" Click="Flush_Click">
                    <StackPanel>
                        <core:IconBadge Style="{StaticResource TileIcon}" Glyph="&#xE74D;" Tint="blue"/>
                        <TextBlock Text="Flush DNS" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Clear cached lookups" Foreground="{StaticResource SubTextBrush}" FontSize="12.5" FontWeight="Normal" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource TileButton}" Click="Renew_Click">
                    <StackPanel>
                        <core:IconBadge Style="{StaticResource TileIcon}" Glyph="&#xE895;" Tint="purple"/>
                        <TextBlock Text="Renew IP" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Get a new IP" Foreground="{StaticResource SubTextBrush}" FontSize="12.5" FontWeight="Normal" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource TileButton}" Click="FullReset_Click">
                    <StackPanel>
                        <core:IconBadge Style="{StaticResource TileIcon}" Glyph="&#xE945;" Tint="pink"/>
                        <TextBlock Text="Network Reset" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Renew IP + flush DNS" Foreground="{StaticResource SubTextBrush}" FontSize="12.5" FontWeight="Normal" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="6" Style="{StaticResource TileButton}" Click="Reset_Click">
                    <StackPanel>
                        <core:IconBadge Style="{StaticResource TileIcon}" Glyph="&#xE894;" Tint="orange"/>
                        <TextBlock Text="Remove DNS" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Clear custom DNS" Foreground="{StaticResource SubTextBrush}" FontSize="12.5" FontWeight="Normal" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="8" Style="{StaticResource TileButton}" Click="Benchmark_Click">
                    <StackPanel>
                        <core:IconBadge Style="{StaticResource TileIcon}" Glyph="&#xEC4A;" Tint="green"/>
                        <TextBlock Text="Speed Test" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Find the fastest" Foreground="{StaticResource SubTextBrush}" FontSize="12.5" FontWeight="Normal" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Fastest -->
            <Grid Margin="0,30,0,14">
                <TextBlock Text="Fastest For You" Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="{Binding IsBenchmarking, Converter={StaticResource BoolToVis}}">
                    <Control Template="{StaticResource SpinnerTemplate}" Width="16" Height="16"/>
                    <TextBlock Text="Measuring response times…" Foreground="{StaticResource SubTextBrush}" FontSize="12.5" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="28" x:Name="EmptyFastest">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="10" Background="#1ABF5AF2">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="24" Foreground="#FFBF5AF2" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                        <TextBlock Text="No speed test yet" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Measure every DNS server from your connection and get the top picks here." Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="Benchmark_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,9,0"/>
                            <TextBlock Text="Run Speed Test"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Fastest}" x:Name="FastestList" core:Reveal.Stagger="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type core:DnsItem}">
                        <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <core:IconBadge Letter="{Binding Initial}" Brush="{Binding Accent}" Size="38"/>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Primary}" Style="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Latency}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="ms" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,-4,0,0"/>
                                </StackPanel>
                                <Button Grid.Row="1" Grid.ColumnSpan="3" Margin="0,18,0,0" Click="ApplyFastest_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                            <Setter Property="Content" Value="Use this DNS"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFastest}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="Content" Value="★  Use the fastest"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Content" Value="✓  Active now"/>
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

