<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EtherDNS</RootNamespace>
    <AssemblyName>EtherDNS</AssemblyName>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <!-- Build with -p:NoAdmin=true to run without the UAC prompt (UI preview / debugging) -->
    <ApplicationManifest Condition="'$(NoAdmin)' != 'true'">app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>2.1.0</Version>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <Product>EtherDNS</Product>
    <Company>DevUranium</Company>
    <Description>EtherDNS - DNS changer and network toolkit</Description>
    <Copyright>Copyright © DevUranium. All rights reserved.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="legacy\**;publish\**;dist\**;installer\**" />
    <None Remove="legacy\**;publish\**;dist\**;installer\**" />
    <Resource Include="Resources\icon.ico" />
  </ItemGroup>

</Project>
